<?xml version="1.0"?>
<ruleset name="Additional Gallery for HivePress">
	<description>Coding standard for Additional Gallery for HivePress: WordPress rules, aligned with the HivePress house style.</description>

	<file>.</file>
	<exclude-pattern>*/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="s"/>

	<config name="text_domain" value="additional-gallery-for-hivepress"/>
	<config name="prefixes" value="hp_agl,HP_AGL,HivePress"/>

	<rule ref="WordPress">
		<!-- HivePress uses short array syntax throughout; this extension matches the host plugin. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- HivePress hook names use slashes (hivepress/v1/...); hp_agl/... follows the same convention. -->
		<exclude name="WordPress.NamingConventions.ValidHookName"/>
	</rule>
</ruleset>
